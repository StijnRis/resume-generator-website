{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BatchedCvTextGeneration",
  "type": "object",
  "properties": {
    "summary": { "type": "string" },
    "experiences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "summary": { "type": "string" },
          "bullets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "text": { "type": "string" }
              },
              "required": ["id", "text"],
              "additionalProperties": false
            }
          },
          "title": { "type": "string" },
          "organization": { "type": "string" },
          "location": { "type": "string" }
        },
        "required": ["id", "summary", "bullets"],
        "additionalProperties": false
      }
    },
    "attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" }
        },
        "required": ["id", "title"],
        "additionalProperties": false
      }
    },
    "ui_labels": {
      "type": "object",
      "properties": {
        "at": { "type": "string" },
        "present": { "type": "string" },
        "starting": { "type": "string" },
        "expected": { "type": "string" }
      },
      "required": ["at", "present", "starting", "expected"],
      "additionalProperties": false
    }
  },
  "required": ["summary", "experiences", "attributes", "ui_labels"],
  "additionalProperties": false
}
