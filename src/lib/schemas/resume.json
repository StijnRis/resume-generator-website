{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DynamicGeneralResume",
  "type": "object",
  "properties": {
    "summary": { "type": "string" },
    "experience_categories": {
      "type": "array",
      "items": { "$ref": "#/definitions/ExperienceCategory" }
    },
    "attribute_categories": {
      "type": "array",
      "items": { "$ref": "#/definitions/AttributeCategory" }
    }
  },
  "required": ["summary", "experience_categories", "attribute_categories"],
  "additionalProperties": false,
  "definitions": {
    "ExperienceCategory": {
      "type": "object",
      "properties": {
        "category": { "type": "string" },
        "experiences": {
          "type": "array",
          "items": { "$ref": "#/definitions/DynamicExperience" }
        }
      },
      "required": ["category", "experiences"],
      "additionalProperties": false
    },
    "DynamicExperience": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "detail": { "type": "string" }
            },
            "required": ["detail"],
            "additionalProperties": false
          }
        }
      },
      "required": ["id", "title", "details"],
      "additionalProperties": false
    },
    "AttributeCategory": {
      "type": "object",
      "properties": {
        "category": { "type": "string" },
        "attributes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "item": { "type": "string" }
            },
            "required": ["id", "item"],
            "additionalProperties": false
          }
        }
      },
      "required": ["category", "attributes"],
      "additionalProperties": false
    }
  }
}
