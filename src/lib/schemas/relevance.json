{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HighLevelAnalysis",
  "type": "object",
  "properties": {
    "experience_categories": {
      "type": "array",
      "items": { "$ref": "#/definitions/DynamicCategoryDefinition" }
    },
    "attribute_categories": {
      "type": "array",
      "items": { "$ref": "#/definitions/DynamicCategoryDefinition" }
    },
    "experience_analysis": {
      "type": "array",
      "items": { "$ref": "#/definitions/ExperienceAnalysisItem" }
    },
    "attribute_analysis": {
      "type": "array",
      "items": { "$ref": "#/definitions/AttributeAnalysisItem" }
    },
    "experience_merges": {
      "type": "array",
      "items": { "$ref": "#/definitions/ExperienceMergeGroup" }
    },
    "summary_importance": { "type": "integer", "minimum": 0, "maximum": 100 }
  },
  "required": [
    "experience_categories",
    "attribute_categories",
    "experience_analysis",
    "attribute_analysis",
    "experience_merges",
    "summary_importance"
  ],
  "additionalProperties": false,
  "definitions": {
    "DynamicCategoryDefinition": {
      "type": "object",
      "properties": {
        "label": { "type": "string" },
        "order": { "type": "integer", "minimum": 1, "maximum": 20 },
        "reason": { "type": "string" }
      },
      "required": ["label", "order", "reason"],
      "additionalProperties": false
    },
    "ExperienceBulletCandidate": {
      "type": "object",
      "properties": {
        "topic": { "type": "string" },
        "importance": { "type": "integer", "minimum": 0, "maximum": 100 }
      },
      "required": ["topic", "importance"],
      "additionalProperties": false
    },
    "ExperienceAnalysisItem": {
      "type": "object",
      "properties": {
        "category": { "type": "string" },
        "id": { "type": "string" },
        "relevance_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "reason": { "type": "string" },
        "bullets": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/definitions/ExperienceBulletCandidate" }
        }
      },
      "required": ["category", "id", "relevance_score", "reason", "bullets"],
      "additionalProperties": false
    },
    "AttributeAnalysisItem": {
      "type": "object",
      "properties": {
        "category": { "type": "string" },
        "id": { "type": "string" },
        "relevance_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "reason": { "type": "string" }
      },
      "required": ["category", "id", "relevance_score", "reason"],
      "additionalProperties": false
    },
    "ExperienceMergeGroup": {
      "type": "object",
      "properties": {
        "member_ids": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string" }
        },
        "category": { "type": "string" },
        "relevance_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "reason": { "type": "string" },
        "bullets": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/definitions/ExperienceBulletCandidate" }
        }
      },
      "required": [
        "member_ids",
        "category",
        "relevance_score",
        "reason",
        "bullets"
      ],
      "additionalProperties": false
    }
  }
}
